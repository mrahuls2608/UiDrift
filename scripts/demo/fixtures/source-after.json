   "path": "tokens.css",
   "content": "/* Generated by UIDrift from the most used values on the scanned site. */\n:root {\n  --color-1: #ffffff;\n  --color-2: #2563eb;\n  --color-3: #111827;\n  --color-4: #3b82f6;\n  --color-5: #0ea5e9;\n  --color-6: #1d4ed8;\n  --color-7: #1f2937;\n  --color-8: #d1d5db;\n  --color-9: #111111;\n  --color-10: #16a34a;\n  --color-11: #374151;\n  --color-12: #7c3aed;\n  --color-primary: #0ea5e9;\n  --font-family-base: 'inter', system-ui, sans-serif;\n  --font-size-xs: 14px;\n  --font-size-sm: 16px;\n  --font-size-base: 18px;\n  --font-size-lg: 20px;\n  --font-size-xl: 28px;\n  --font-size-2xl: 30px;\n  --font-size-3xl: 40px;\n  --font-size-4xl: 44px;\n  --space-1: 6px;\n  --space-2: 8px;\n  --space-3: 10px;\n  --space-4: 12px;\n  --space-5: 16px;\n  --space-6: 18px;\n  --space-7: 20px;\n  --space-8: 24px;\n  --radius-sm: 6px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-xl: 9999px;\n}\n"
  },
  {
   "path": "components/Button.tsx",
   "content": "import type { ButtonHTMLAttributes, CSSProperties } from 'react';\n\nexport type ButtonVariant = 'primary' | 'secondary' | 'tertiary';\n\nconst base: CSSProperties = {\n  display: 'inline-flex',\n  alignItems: 'center',\n  justifyContent: 'center',\n  gap: '0.5em',\n  cursor: 'pointer',\n  fontFamily: 'var(--font-family-base, inherit)',\n  lineHeight: 1.2,\n};\n\nconst variants: Record<ButtonVariant, CSSProperties> = {\n  \"primary\": {\n    \"backgroundColor\": \"var(--color-primary)\",\n    \"color\": \"var(--color-1)\",\n    \"fontSize\": \"var(--font-size-sm)\",\n    \"padding\": \"var(--space-3) var(--font-size-base)\",\n    \"borderRadius\": \"var(--space-2)\",\n    \"border\": \"none\"\n  },\n  \"secondary\": {\n    \"backgroundColor\": \"var(--color-2)\",\n    \"color\": \"var(--color-1)\",\n    \"fontSize\": \"var(--font-size-xs)\",\n    \"fontWeight\": \"600\",\n    \"padding\": \"var(--space-3) var(--font-size-lg)\",\n    \"borderRadius\": \"var(--space-1)\",\n    \"border\": \"none\"\n  },\n  \"tertiary\": {\n    \"backgroundColor\": \"var(--color-12)\",\n    \"color\": \"var(--color-1)\",\n    \"fontSize\": \"var(--font-size-base)\",\n    \"fontWeight\": \"700\",\n    \"padding\": \"var(--font-size-xs) 32px\",\n    \"borderRadius\": \"var(--space-4)\",\n    \"border\": \"none\",\n    \"boxShadow\": \"0 10px 16px -2px #0000001a, 0 4px 6px -4px #0000001a\"\n  }\n};\n\nexport interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {\n  variant?: ButtonVariant;\n}\n\nexport function Button({ variant = 'primary', style, type = 'button', ...props }: ButtonProps) {\n  return <button type={type} style={{ ...base, ...variants[variant], ...style }} {...props} />;\n}\n"
  },
  {
   "path": "components/Input.tsx",
   "content": "import { forwardRef, type CSSProperties, type InputHTMLAttributes } from 'react';\n\nconst inputStyle: CSSProperties = {\n  \"fontFamily\": \"var(--font-family-base, inherit)\",\n  \"fontSize\": \"var(--font-size-xs)\",\n  \"padding\": \"var(--space-2) var(--space-4)\",\n  \"borderRadius\": \"var(--space-1)\",\n  \"border\": \"1px solid var(--color-8)\"\n};\n\nexport interface InputProps extends InputHTMLAttributes<HTMLInputElement> {\n  label?: string;\n}\n\nexport const Input = forwardRef<HTMLInputElement, InputProps>(function Input(\n  { label, id, style, ...props },\n  ref,\n) {\n  const field = <input ref={ref} id={id} style={{ ...inputStyle, ...style }} {...props} />;\n  if (!label) return field;\n  return (\n    <label htmlFor={id} style={{ display: 'grid', gap: '0.25rem' }}>\n      <span>{label}</span>\n      {field}\n    </label>\n  );\n});\n"
  },
  {
   "path": "components/Card.tsx",
   "content": "import type { CSSProperties, HTMLAttributes } from 'react';\n\nconst cardStyle: CSSProperties = {\n  \"backgroundColor\": \"var(--color-1)\",\n  \"padding\": \"var(--font-size-sm) var(--font-size-sm)\",\n  \"borderRadius\": \"var(--space-4)\",\n  \"border\": \"1px solid #e5e7eb\"\n};\n\nexport function Card({ style, ...props }: HTMLAttributes<HTMLDivElement>) {\n  return <div style={{ ...cardStyle, ...style }} {...props} />;\n}\n"
  },
  {
   "path": "components/Heading.tsx",
   "content": "import type { CSSProperties, HTMLAttributes } from 'react';\n\ntype Level = 1 | 2 | 3 | 4 | 5 | 6;\n\nconst levels: Record<Level, CSSProperties> = {\n  \"1\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-3)\",\n    \"fontSize\": \"var(--font-size-4xl)\",\n    \"fontWeight\": \"800\",\n    \"border\": \"none\"\n  },\n  \"2\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-3)\",\n    \"fontSize\": \"var(--font-size-4xl)\",\n    \"border\": \"none\"\n  },\n  \"3\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-9)\",\n    \"fontSize\": \"var(--font-size-3xl)\",\n    \"fontWeight\": \"700\",\n    \"border\": \"none\"\n  },\n  \"4\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-7)\",\n    \"fontSize\": \"var(--font-size-2xl)\",\n    \"fontWeight\": \"700\",\n    \"border\": \"none\"\n  },\n  \"5\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-7)\",\n    \"fontSize\": \"var(--font-size-xl)\",\n    \"fontWeight\": \"600\",\n    \"border\": \"none\"\n  },\n  \"6\": {\n    \"margin\": \"0\",\n    \"color\": \"var(--color-11)\",\n    \"fontSize\": \"var(--font-size-lg)\",\n    \"fontWeight\": \"600\",\n    \"border\": \"none\"\n  }\n};\n\nexport interface HeadingProps extends HTMLAttributes<HTMLHeadingElement> {\n  level?: Level;\n}\n\nexport function Heading({ level = 2, style, ...props }: HeadingProps) {\n  const Tag = `h${level}` as const;\n  return <Tag style={{ fontFamily: 'var(--font-family-base, inherit)', ...levels[level], ...style }} {...props} />;\n}\n"
  },
  {
   "path": "components/index.ts",
   "content": "export * from './Button';\nexport * from './Input';\nexport * from './Card';\nexport * from './Heading';\n"
  }
 ],
