PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/uidrift
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters. Required in production.
JWT_SECRET=
# The Next.js app origin (CORS)
CLIENT_URL=http://localhost:3000
MAX_PAGES=10
# true = API process also runs the scan worker (free tier, single dyno)
RUN_WORKER_INLINE=true
# Optional: path to a Chrome/Chromium binary (otherwise Puppeteer's bundled Chrome)
CHROME_PATH=
SCAN_RATE_LIMIT_PER_HOUR=5
LOG_LEVEL=info
# Note: LLM API keys are never configured here. Users enter their own key per audit (UI or CLI).
