{
  "name": "@uidrift/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "npm run build --prefix ../shared",
    "seed": "tsx src/scripts/seed.ts",
    "analyze": "tsx src/cli/analyze-source.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "demo:fixtures": "tsx src/scripts/make-demo-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@axe-core/puppeteer": "^4.10.1",
    "@uidrift/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "culori": "^4.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mongoose": "^8.9.3",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "puppeteer": "^24.43.1",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/culori": "^2.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
