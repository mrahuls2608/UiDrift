# Where the Next.js server proxies /api/v1/* (server-side only)
API_URL=http://localhost:4000
# Optional: call the API directly for live progress (SSE) instead of through the Next.js proxy
NEXT_PUBLIC_SSE_URL=
# Set to false to hide the "Log in as demo user" shortcut on the login page
NEXT_PUBLIC_DEMO_LOGIN=true
